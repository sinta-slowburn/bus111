# GEMINI_API_KEY: Required for Gemini AI server-side crowd intelligence and situation analysis.
# Do NOT paste secret keys into the repository or client-side code.
# Configure this key directly in Vercel: Project Settings -> Environment Variables.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

